{
  "name": "@indev42/connections",
  "version": "1.0.0",
  "description": "OAuth and static token management for app integrations.",
  "homepage": "https://github.com/inDev42Labs/connections#readme",
  "bugs": {
    "url": "https://github.com/inDev42Labs/connections/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inDev42Labs/connections.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "dev": "tsdown --watch",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "bun run build",
    "version-packages": "changeset version",
    "release": "changeset publish --tag latest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./encryptors": {
      "types": "./dist/encryptors/index.d.ts",
      "import": "./dist/encryptors/index.js"
    },
    "./encryptors/aes-gcm": {
      "types": "./dist/encryptors/aes-gcm/index.d.ts",
      "import": "./dist/encryptors/aes-gcm/index.js"
    },
    "./providers/dummy": {
      "types": "./dist/providers/dummy/index.d.ts",
      "import": "./dist/providers/dummy/index.js"
    },
    "./providers/retell": {
      "types": "./dist/providers/retell/index.d.ts",
      "import": "./dist/providers/retell/index.js"
    },
    "./providers/salesforce": {
      "types": "./dist/providers/salesforce/index.d.ts",
      "import": "./dist/providers/salesforce/index.js"
    },
    "./providers/zoho": {
      "types": "./dist/providers/zoho/index.d.ts",
      "import": "./dist/providers/zoho/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    },
    "./sources/environment": {
      "types": "./dist/sources/environment/index.d.ts",
      "import": "./dist/sources/environment/index.js"
    },
    "./stores/convex": {
      "types": "./dist/stores/convex/index.d.ts",
      "import": "./dist/stores/convex/index.js"
    },
    "./stores/memory": {
      "types": "./dist/stores/memory/index.d.ts",
      "import": "./dist/stores/memory/index.js"
    },
    "./stores/neon": {
      "types": "./dist/stores/neon/index.d.ts",
      "import": "./dist/stores/neon/index.js"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "latest",
    "oxlint": "^1.73.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.3.13"
}
